APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/agentinsight.db
AUTO_CREATE_SCHEMA=true
FRONTEND_ORIGINS=["http://localhost:5173"]
SSE_HEARTBEAT_SECONDS=15
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Model Gateway：目录只保存环境变量名，不保存密钥值。
MODEL_CATALOG_JSON=[]
DEFAULT_MODEL_ID=
MODEL_MAX_RETRIES=2
MODEL_RETRY_BASE_SECONDS=0.5

# Future integrations
# Provider keys are added locally when their providers are configured.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
AGENTINSIGHT_API_KEY=
