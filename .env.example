APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/agentinsight.db
AUTO_CREATE_SCHEMA=true
FRONTEND_ORIGINS=["http://localhost:5173"]
SSE_HEARTBEAT_SECONDS=15
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Model Gateway：赛事路由的非敏感配置；目录只保存密钥变量名。
MODEL_CATALOG_JSON=[{"model_id":"anker:glm-5.2","provider":"anker-router","provider_model":"hackathon/v_model/glm-5.2","display_name":"GLM 5.2","credential_env":"ANKER_ROUTER_API_KEY","capabilities":["text","structured_output"],"provider_options":{"structured_output_mode":"prompt"}},{"model_id":"anker:deepseek-v4-pro","provider":"anker-router","provider_model":"hackathon/v_model/deepseek-v4-pro","display_name":"DeepSeek V4 Pro","credential_env":"ANKER_ROUTER_API_KEY","capabilities":["text","structured_output"],"provider_options":{"structured_output_mode":"prompt"}}]
MODEL_CREDENTIALS_ENV_FILE=.env
OPENAI_COMPATIBLE_PROVIDERS_JSON=[{"provider_id":"anker-router","base_url":"https://ai-router-cn-pub.anker-in.com"}]
DEFAULT_MODEL_ID=anker:glm-5.2
MODEL_MAX_RETRIES=2
MODEL_RETRY_BASE_SECONDS=0.5
BRIEF_CLARIFIER_MODEL_TIMEOUT_SECONDS=120

# User Research Agent evidence window. Model reasoning uses only eligible Evidence IDs.
USER_RESEARCH_MAX_EVIDENCE_ITEMS=30
USER_RESEARCH_MAX_EXCERPT_CHARS=2000
USER_RESEARCH_MAX_TOTAL_EVIDENCE_CHARS=40000

# Competitor discovery only classifies candidate_only search results before a human Gate.
COMPETITOR_DISCOVERY_MODEL_TIMEOUT_SECONDS=180
COMPETITOR_DISCOVERY_RUNTIME_TIMEOUT_SECONDS=600
COMPETITOR_DISCOVERY_MAX_INPUT_CANDIDATES=50
COMPETITOR_DISCOVERY_MAX_SNIPPET_CHARS=1000

# Price-channel specialist evidence window. Observations remain time- and region-bound.
COMPETITOR_PRICE_MAX_EVIDENCE_ITEMS=60
COMPETITOR_PRICE_MAX_EXCERPT_CHARS=3000
COMPETITOR_PRICE_MAX_TOTAL_EVIDENCE_CHARS=80000
COMPETITOR_PRICE_MODEL_TIMEOUT_SECONDS=180

# Competitor user-review evidence window. Only reviewed user_opinion Evidence is eligible.
COMPETITOR_REVIEW_MAX_EVIDENCE_ITEMS=80
COMPETITOR_REVIEW_MAX_EXCERPT_CHARS=3000
COMPETITOR_REVIEW_MAX_TOTAL_EVIDENCE_CHARS=100000
COMPETITOR_REVIEW_MODEL_TIMEOUT_SECONDS=180
COMPETITOR_SYNTHESIS_MODEL_TIMEOUT_SECONDS=180
COMPETITOR_ECOSYSTEM_MODEL_TIMEOUT_SECONDS=180
COMPETITOR_ECOSYSTEM_MAX_EVIDENCE_ITEMS=200
COMPETITOR_ECOSYSTEM_MAX_EXCERPT_CHARS=3000
COMPETITOR_ECOSYSTEM_MAX_TOTAL_EVIDENCE_CHARS=200000

# Ecosystem opportunity generation shares upstream Evidence and verified capability claims.
ECOSYSTEM_OPPORTUNITY_MAX_EVIDENCE_ITEMS=120
ECOSYSTEM_OPPORTUNITY_MAX_EXCERPT_CHARS=2000
ECOSYSTEM_OPPORTUNITY_MAX_TOTAL_EVIDENCE_CHARS=120000
ECOSYSTEM_OPPORTUNITY_MODEL_TIMEOUT_SECONDS=180

# User-authorized source ingestion. Runtime files stay local and are ignored by git.
SOURCE_STORAGE_ROOT=./data/sources
SOURCE_MAX_UPLOAD_BYTES=262144000
SOURCE_PROCESSING_WORKSPACE_ROOT=./data/source-processing
SOURCE_PROCESSING_MAX_INPUT_BYTES=52428800
SOURCE_PROCESSING_MAX_FRAGMENTS=5000
SOURCE_PROCESSING_MAX_EXCERPT_CHARS=4000

# Authorized public webpage connector. No login, browser automation, or anti-bot bypass.
WEB_CONNECTOR_ENABLED=true
WEB_CONNECTOR_USER_AGENT=AgentInsightResearchBot/0.1
WEB_CONNECTOR_TIMEOUT_SECONDS=20
WEB_CONNECTOR_MAX_RESPONSE_BYTES=5242880
WEB_CONNECTOR_MAX_REDIRECTS=5
WEB_CONNECTOR_RESPECT_ROBOTS_TXT=true
# Optional deployment allowlist; an empty list permits public domains after SSRF checks.
WEB_CONNECTOR_ALLOWED_DOMAINS=[]

# Search discovery only returns candidate URLs; candidates are never Evidence.
SEARCH_DISCOVERY_ENABLED=true
SEARCH_DISCOVERY_TAVILY_CREDENTIAL_ENV=TAVILY_API_KEY
SEARCH_DISCOVERY_TIMEOUT_SECONDS=20
SEARCH_DISCOVERY_MAX_RESPONSE_BYTES=1048576

# Authorized audio/video preprocessing. Semantic ASR/vision requires a separate connector.
MEDIA_PROCESSING_MAX_DURATION_SECONDS=1800
MEDIA_PROCESSING_MAX_STREAMS=8
MEDIA_PROCESSING_FRAME_INTERVAL_SECONDS=10
MEDIA_PROCESSING_MAX_FRAMES=60
MEDIA_PROCESSING_MAX_FRAME_DIMENSION=1280
MEDIA_PROCESSING_MAX_DECODED_VIDEO_FRAMES=100000
MEDIA_PROCESSING_AUDIO_SAMPLE_RATE=16000
MEDIA_PROCESSING_MAX_AUDIO_BYTES=115200000

# External Agent CLI runtime. Secrets remain in the local credential env only.
EXTERNAL_RUNTIME_WORKSPACE_ROOT=./data/runtime
EXTERNAL_CLI_MAX_OUTPUT_BYTES=4194304
EXTERNAL_CLI_PROBE_TIMEOUT_SECONDS=5
OPENCODE_RUNTIME_ENABLED=true
OPENCODE_EXECUTABLE=opencode
OPENCODE_PROVIDER_ID=anker-router
OPENCODE_PROVIDER_NAME=Anker Router
OPENCODE_PROVIDER_BASE_URL=https://ai-router-cn-pub.anker-in.com
OPENCODE_PROVIDER_MODEL=hackathon/v_model/glm-5.2
OPENCODE_CREDENTIAL_ENV=ANKER_ROUTER_API_KEY

# Future integrations
# Provider keys are added locally when their providers are configured.
# ANKER_ROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# TAVILY_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
AGENTINSIGHT_API_KEY=
